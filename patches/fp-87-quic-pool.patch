+/*
+ * nginx-fp fix for phuslu/nginx-ssl-fingerprint#87.
+ *
+ * On HTTP/3 every QUIC stream has its own short-lived c->pool, but all
+ * streams share c->ssl.  The strings cached on c->ssl must therefore be
+ * allocated from the pool of the connection that owns the SSL object (the
+ * one ngx_ssl_create_connection() stored in the SSL ex_data), which lives
+ * as long as c->ssl does.  For HTTP/1.x and HTTP/2 that is the same pool
+ * as c->pool, so nothing changes there.
+ */
+static void *
+ngx_ssl_fp_pnalloc(ngx_connection_t *c, size_t size)
+{
+    ngx_connection_t  *owner;
+
+    owner = ngx_ssl_get_connection(c->ssl->connection);
+
+    if (owner == NULL || owner->ssl != c->ssl || owner->pool == NULL) {
+        ngx_log_error(NGX_LOG_WARN, c->log, 0,
+                "ssl fingerprint: no connection-lifetime pool");
+        return NULL;
+    }
+
+    return ngx_pnalloc(owner->pool, size);
+}
+
